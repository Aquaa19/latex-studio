# TeXForge / LaTeX Studio Configuration

# Remote backend compiler URL (e.g. Render: https://latex-studio.onrender.com)
# Used for HTML-to-PDF export (Puppeteer) and multi-file projects with binary image assets.
# Leave blank on Vercel if only compiling standard LaTeX documents via TeX Live cloud.
VITE_API_BASE_URL=https://latex-studio.onrender.com

# Local / self-hosted compiler URL when accessed from a web browser
# (Defaults to window.location.origin in Electron and on localhost/127.0.0.1)
VITE_LOCAL_COMPILER_URL=http://localhost:2345

# Priority order of compile backends to try (comma-separated: wasm,texlive,remote)
# In Electron or on localhost, "local" is always used exclusively.
VITE_COMPILE_BACKENDS=wasm,texlive,remote

# Enable experimental client-side WebAssembly compiler (BusyTeX)
# Values: true | false (default: false)
VITE_ENABLE_WASM=false
